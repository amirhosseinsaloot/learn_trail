# Nuroli configuration. Copy this file to .env (git-ignored) and replace the
# placeholders. One file is read by Docker Compose and, once at start, by the
# API (docs/rebuild/ARCHITECTURE.md section 16). Every value below is a
# placeholder or a development default; none is a real credential.

## Required at start

# Public origin as users reach the app: scheme and host, no path. Cookies,
# the CSRF Origin check, and the Google redirect URI derive from it.
NUROLI_PUBLIC_ORIGIN=http://localhost:8080

# At least 32 random bytes; signs the Google sign-in state cookie.
# Generate with: openssl rand -hex 32
NUROLI_SECRET_KEY=replace-with-the-output-of-openssl-rand-hex-32

# Async SQLAlchemy URL. Inside Compose the host is the db service and the
# password must equal the PostgreSQL password below.
NUROLI_DATABASE_URL=postgresql+asyncpg://nuroli:replace-me@db:5432/nuroli

# Password the db container assigns to the nuroli role on first start.
POSTGRES_PASSWORD=replace-me

# OpenAI-compatible base URL. Development default: the fake model container.
# Host-local runtime example: http://host.docker.internal:11434/v1
NUROLI_MODEL_BASE_URL=http://fake-model:9000/v1

# Model identifier sent as "model" in every request.
NUROLI_MODEL_NAME=fake-model

## Model connection (optional; ARCHITECTURE.md section 11.1)

# Bearer token for the model endpoint. Leave empty for local runtimes.
NUROLI_MODEL_API_KEY=

# Total request timeout in seconds (R-21).
NUROLI_MODEL_TIMEOUT_SECONDS=120

# Seconds allowed until the first streamed token (R-21).
NUROLI_MODEL_FIRST_TOKEN_TIMEOUT_SECONDS=30

# max_tokens sent per request (R-21).
NUROLI_MODEL_MAX_OUTPUT_TOKENS=2048

# JSON object of extra request headers, for example OpenRouter attribution.
NUROLI_MODEL_EXTRA_HEADERS=

## Web research (optional; R-07, R-08)

# "none" disables research cleanly; "tavily" needs the key below.
NUROLI_SEARCH_PROVIDER=none

# Tavily API key. Required only when the provider above is tavily.
NUROLI_TAVILY_API_KEY=

# Tavily base URL. End-to-end tests point it at the fake container.
NUROLI_TAVILY_BASE_URL=https://api.tavily.com

## Google sign-in (optional; both empty means the button is hidden)

# OAuth client id from Google Cloud Console.
NUROLI_GOOGLE_CLIENT_ID=

# OAuth client secret from Google Cloud Console.
NUROLI_GOOGLE_CLIENT_SECRET=

## Accounts and sessions

# Whether new accounts may register (R-14). The first account is always admin.
NUROLI_REGISTRATION_OPEN=true

# Idle (sliding) session lifetime in days (R-35); absolute lifetime is 90 days.
NUROLI_SESSION_TTL_DAYS=30

# Session cookie Secure flag. Keep true; localhost counts as secure in browsers.
NUROLI_SESSION_COOKIE_SECURE=true

## Limits (R-21 defaults, enforced server-side)

# Concurrent model-backed operations per user.
NUROLI_MAX_CONCURRENT_STREAMS_PER_USER=1

# Replies (including draft generation and knowledge answers) per user per hour.
NUROLI_MAX_REPLIES_PER_HOUR=60

# Web searches per user per hour.
NUROLI_MAX_SEARCHES_PER_HOUR=30

# Characters of conversation context sent to the model; oldest dropped first.
NUROLI_CONTEXT_BUDGET_CHARS=24000

# Request body limit in bytes, enforced by nginx and the API.
NUROLI_MAX_REQUEST_BODY_BYTES=65536

## Logging (ARCHITECTURE.md section 19)

# debug, info, warning, or error.
NUROLI_LOG_LEVEL=info

# json for Compose and production; text for local development.
NUROLI_LOG_FORMAT=json

# Peers whose X-Forwarded-For header is honoured; default is the Compose network.
NUROLI_TRUSTED_PROXY_CIDR=172.16.0.0/12

## Ports and Compose project (IMPLEMENTATION.md section 4.3)
# Ticket worktrees override these through the git-ignored .worktree.env file
# written by `make worktree`; the main checkout uses offset 0.

# Compose project name; worktrees use nuroli-nu<nnn>.
COMPOSE_PROJECT_NAME=nuroli

# The only port published by the release stack (web container).
NUROLI_WEB_PORT=8080

# Development stack: API published on the host for direct calls.
NUROLI_DEV_API_PORT=8000

# Development stack: PostgreSQL published on the host for tests and tools.
NUROLI_DEV_DB_PORT=5432

# Development stack: Vite dev server with the /api proxy.
NUROLI_DEV_VITE_PORT=5173

# Development stack: fake model container.
NUROLI_DEV_FAKE_MODEL_PORT=9000

## Release

# Image tag used by compose.yaml; pin to a release tag in production.
NUROLI_VERSION=latest
