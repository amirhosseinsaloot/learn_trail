# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / pnpm (apps/web). pnpm-lock.yaml is committed on purpose.
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*

# Next.js build output and generated types. next-env.d.ts is regenerated by
# `next typegen` / `next dev` / `next build`; Next itself says not to edit it.
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Environment files. Nothing in this repo should carry provider credentials into
# the frontend (CLAUDE.md invariant #3) — this is belt and braces.
.env
.env.*
!.env.example

# DeepEval writes a telemetry/state directory beside whatever invokes it
# (Phase 6). Not ours, not reproducible, and it landed in a commit once.
.deepeval/
.deepeval-cache.json

# Graphify (dev/Claude tooling, docs/STATE.md). Regenerated locally in seconds
# via `make graphify-update` (AST-only, no LLM cost) — committing it would mean
# a multi-MB near-binary diff on every commit for zero benefit, and Biome/Ruff
# would otherwise walk into its cache/ as source (it trusts .gitignore, not
# .graphifyignore). GRAPH_REPORT.md is regenerated the same way; if you want a
# point-in-time copy reviewable in a PR, commit it explicitly with `git add -f`.
graphify-out/
