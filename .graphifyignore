# generated/dependency/cache output and secrets are excluded here.

# VCS / editor
.git/

# Python
.venv/
__pycache__/
**/__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc

# Node / pnpm (apps/web)
node_modules/
**/node_modules/
.pnpm-store/
.next/
out/
dist/
build/
coverage/
.turbo/
next-env.d.ts
*.tsbuildinfo

# Lockfiles (generated, not architecture)
uv.lock
pnpm-lock.yaml
*.lock

# Eval tooling scratch state (Phase 6)
.deepeval/
.deepeval-cache.json

# Secrets - never index these
.env
.env.*
!.env.example

# Graphify's own output and its bundled skill docs (about the tool, not the project)
graphify-out/
.claude/skills/graphify/
